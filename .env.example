# ==============================================================================
# BantayNet Production Environment Security Configuration
# Copy this file to '.env' and populate with your environment-specific secrets.
# Do NOT commit '.env' containing production credentials to version control.
# ==============================================================================

# 1. Flask Secret Key (CRITICAL FOR PRODUCTION)
# Must be a high-entropy secret string to sign and encrypt session cookies.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
BANTAYNET_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key

# 2. Session & HTTPS Security
# Set to 1 when serving over HTTPS/TLS (reverse proxy like Nginx, Caddy, Cloudflare, etc.)
# This enables the 'Secure' flag on cookies and Strict-Transport-Security (HSTS) headers.
BANTAYNET_COOKIE_SECURE=1

# Session lifetime in hours (default: 8)
BANTAYNET_SESSION_HOURS=8

# Session inactivity auto-logout threshold in minutes (default: 15)
BANTAYNET_INACTIVITY_MINUTES=15

# NEVER enable debug mode in production (default: 0)
BANTAYNET_DEBUG=0

# 3. Database Credentials (Supabase PostgreSQL, XAMPP MySQL, or SQLite Fallback)
# Option A: Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here
# Optional direct Postgres URI (Session / Transaction pooler):
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Option B: XAMPP MariaDB/MySQL or Dedicated MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bantaynet_app
MYSQL_PASSWORD=change_this_to_a_strong_database_password
MYSQL_DATABASE=bantaynet_db

# 4. Initial Operator Passwords (used when initializing a new database)
# Optional: Set these if you want custom initial passwords upon first DB initialization.
# BANTAYNET_ADMIN_PASSWORD=admin123!
# BANTAYNET_ANALYST_PASSWORD=analyst123!
# BANTAYNET_VIEWER_PASSWORD=viewer123!

# 5. Email Notifications (for 2FA codes, account setup, & alerts)
# Option A (Recommended for Render): Google Apps Script Gmail Bridge (Sends from your real Gmail via HTTPS Port 443)
GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
GMAIL_WEBHOOK_SECRET=BantayNet2026Secret

# Option B: Mailtrap Email Delivery (HTTPS API & Live SMTP)
# Token generated from https://mailtrap.io (Settings -> API Tokens):
MAILTRAP_API_TOKEN=your_mailtrap_api_token
# Mailtrap SMTP Server (live.smtp.mailtrap.io:587 with STARTTLS)
MAILTRAP_SMTP_SERVER=live.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=api
# Sender: use hello@demomailtrap.co for testing, or your verified domain e.g. hello@umindanao.edu.ph
MAILTRAP_FROM_EMAIL=Private Person <hello@demomailtrap.co>
# Optional: Mailtrap Sandbox Inbox ID (captures dev/test emails without bouncing)
MAILTRAP_INBOX_ID=5007832

# Option B: Resend HTTPS REST API (Port 443 - never blocked)
# RESEND_API_KEY=re_123456789abcdef
# RESEND_FROM_EMAIL=BantayNet SOC <onboarding@resend.dev>

# Option C: Gmail SMTP (Direct / Paid Render / Local Docker)
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Generate an App Password under Security -> App Passwords:
#    https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
GMAIL_USER=your_soc_alerts@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional custom SMTP host/port (defaults to smtp.gmail.com:587 with TLS)
# BANTAYNET_SMTP_SERVER=smtp.gmail.com
# BANTAYNET_SMTP_PORT=587
# BANTAYNET_SMTP_SENDER=BantayNet SOC <your_soc_alerts@gmail.com>


