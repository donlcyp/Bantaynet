# ==============================================================================
# BantayNet Production Environment Security Configuration
# Copy this file to '.env' and populate with your environment-specific secrets.
# Do NOT commit '.env' containing production credentials to version control.
# ==============================================================================

# 1. Flask Secret Key (CRITICAL FOR PRODUCTION)
# Must be a high-entropy secret string to sign and encrypt session cookies.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
BANTAYNET_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key

# 2. Session & HTTPS Security
# Set to 1 when serving over HTTPS/TLS (reverse proxy like Nginx, Caddy, Cloudflare, etc.)
# This enables the 'Secure' flag on cookies and Strict-Transport-Security (HSTS) headers.
BANTAYNET_COOKIE_SECURE=1

# Session lifetime in hours (default: 8)
BANTAYNET_SESSION_HOURS=8

# NEVER enable debug mode in production (default: 0)
BANTAYNET_DEBUG=0

# 3. Database Credentials (XAMPP MariaDB/MySQL or Dedicated Database)
# Leave engine as 'mysql' in rules/rules.yaml to connect, or 'sqlite' for local persistence.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bantaynet_app
MYSQL_PASSWORD=change_this_to_a_strong_database_password
MYSQL_DATABASE=bantaynet_db

# 4. Initial Operator Passwords (used when initializing a new database)
# Replace these default passwords before first run to avoid default credential exposure!
BANTAYNET_ADMIN_PASSWORD=change_this_admin_password_immediately!
BANTAYNET_ANALYST_PASSWORD=change_this_analyst_password_immediately!
BANTAYNET_VIEWER_PASSWORD=change_this_viewer_password_immediately!
